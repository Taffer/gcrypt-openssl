prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@PC_LIBDIR@
includedir=@PC_INCLUDEDIR@

Name: gcrypt-openssl
Description: The Libgcrypt API implemented on top of OpenSSL
Version: @PROJECT_VERSION@
Requires.private: libcrypto >= 4.0
Cflags: -I${includedir}
Libs: -L${libdir} -lgcrypt-openssl
