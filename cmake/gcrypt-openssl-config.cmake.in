@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL 4.0 COMPONENTS Crypto)

# FindGpgError.cmake is installed next to this file.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(GpgError @GCRYPT_OPENSSL_GPG_ERROR_MIN_VERSION@)
list(REMOVE_AT CMAKE_MODULE_PATH -1)

include("${CMAKE_CURRENT_LIST_DIR}/gcrypt-openssl-targets.cmake")

check_required_components(gcrypt-openssl)
